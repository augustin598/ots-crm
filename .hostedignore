# .hostedignore — what to leave OUT of the build context (archive uploaded for
# in-cluster builds). Same syntax as .gitignore. When this file exists it
# REPLACES .gitignore for deploys, so the .gitignore excludes are carried over
# below. .git/ is always excluded, even if this file is empty.
#
# The Dockerfile (app/Dockerfile, context ./) only COPYs app/ — everything else
# here is either regenerated at build time or not part of the app.

# Dependencies — installed by the Dockerfile
node_modules/
.pnpm-store/
vendor/

# Build output — regenerated by `bun run build` in the Dockerfile
dist/
build/
.next/
.svelte-kit/
target/

# `.env` RĂMÂNE în arhivă (2026-08-20): runtime env comes from app-config `config`,
# but `bun run build` (Bun auto-loads .env) evaluates every server module while
# SvelteKit reads route config; without .env those modules fall back to
# localhost/empty values and retry connections for the whole build — the same
# retry storm that OOMKilled build #6caa5570 (2026-07-17). The in-cluster builds
# of 2026-08-17/20 failed the same way once .env was excluded; local Docker builds
# (which include .env) succeed. Only the builder stage sees it — the production
# image copies build output, never .env.
.env.local
.env.*.local
*.pem
*.key
app-config.json
app-config.json.bak

# Carried over from .gitignore — not part of the app
.agents/
.claude/
skills-lock.json
/backups/
whmcs-backup-*.sql
new_design/
ots-wp-connector*.zip
graphify-out/
*_files/
app/Evidenta interviuri*.xlsx
MissingDocuments*.xlsx

# Logs, caches and editor noise
*.log
.cache/
.turbo/
coverage/
.DS_Store
.idea/
.vscode/
