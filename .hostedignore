# .hostedignore — what to leave OUT of the build context (archive uploaded for
# in-cluster builds). Same syntax as .gitignore. When this file exists it
# REPLACES .gitignore for deploys, so the .gitignore excludes are carried over
# below. .git/ is always excluded, even if this file is empty.
#
# The Dockerfile (app/Dockerfile, context ./) only COPYs app/ — everything else
# here is either regenerated at build time or not part of the app.

# Dependencies — installed by the Dockerfile
node_modules/
.pnpm-store/
vendor/

# Build output — regenerated by `bun run build` in the Dockerfile
dist/
build/
.next/
.svelte-kit/
target/

# Local environment and secrets — runtime env comes from app-config `config`;
# the app reads only $env/dynamic/*, so .env is not needed at build time either
.env
.env.*
!.env.example
*.pem
*.key
app-config.json
app-config.json.bak

# Carried over from .gitignore — not part of the app
.agents/
.claude/
skills-lock.json
/backups/
whmcs-backup-*.sql
new_design/
ots-wp-connector*.zip
graphify-out/
*_files/
app/Evidenta interviuri*.xlsx
MissingDocuments*.xlsx

# Logs, caches and editor noise
*.log
.cache/
.turbo/
coverage/
.DS_Store
.idea/
.vscode/
